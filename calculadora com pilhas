#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#define TAM_EXPRESSAO 200
#define TAM_CONVERTIDA 400
//codigo de: Rodrigo Santana
typedef struct NoTexto
{
    char texto[TAM_CONVERTIDA];
    struct NoTexto *prox;
} Tipo_PilhaTexto;

typedef struct RegistroExpressao
{
    char expressao[TAM_EXPRESSAO];
    double resultado;
    int situacao; /* 1 = calculada 2 = invalida 3 = erro no calculo */
    struct RegistroExpressao *prox;
} Tipo_Expressao;
typedef struct NoOperador
{
    char operador;
    struct NoOperador *prox;
} Tipo_PilhaOperador;

typedef struct NoNumero
{
    double valor;
    struct NoNumero *prox;
} Tipo_PilhaNumero;

void inicializa_pilha(Tipo_PilhaOperador **topo)
{
    *topo = NULL;
}

Tipo_PilhaOperador *cria_no_operador(void)
{
    Tipo_PilhaOperador *novo;

    novo = malloc(sizeof(Tipo_PilhaOperador));

    if(novo == NULL){
        printf("Problema de alocacao.\n");
        exit(1);
    }

    novo->prox = NULL;

    return novo;
}

void empilha_operador(Tipo_PilhaOperador **topo, char operador)
{
    Tipo_PilhaOperador *novo;

    novo = cria_no_operador();
    novo->operador = operador;
    novo->prox = *topo;
    *topo = novo;
}

char desempilha_operador(Tipo_PilhaOperador **topo)
{
    Tipo_PilhaOperador *aux;
    char operador;

    if(*topo == NULL){
        return '\0';
    }

    aux = *topo;
    operador = aux->operador;

    *topo = aux->prox;
    free(aux);

    return operador;
}

char consulta_topo(Tipo_PilhaOperador *topo)
{
    if(topo == NULL){
        return '\0';
    }

    return topo->operador;
}

int pilha_vazia(Tipo_PilhaOperador *topo)
{
    return topo == NULL;
}

void libera_pilha(Tipo_PilhaOperador **topo)
{
    while(!pilha_vazia(*topo)){
        desempilha_operador(topo);
    }
}

int eh_operador(char caractere)
{
    if(caractere == '+'){
        return 1;
    }

    if(caractere == '-'){
        return 1;
    }

    if(caractere == '*'){
        return 1;
    }

    if(caractere == '/'){
        return 1;
    }

    if(caractere == '^'){
        return 1;
    }

    return 0;
}

int eh_digito(char caractere)
{
    if(caractere >= '0' && caractere <= '9'){
        return 1;
    }

    return 0;
}

int prioridade(char operador)
{
    if(operador == '+'){
        return 1;
    }

    if(operador == '-'){
        return 1;
    }

    if(operador == '*'){
        return 2;
    }

    if(operador == '/'){
        return 2;
    }

    if(operador == '^'){
        return 3;
    }

    return 0;
}

void limpa_entrada(void)
{
    int caractere;

    caractere = getchar();

    while(caractere != '\n' && caractere != EOF){
        caractere = getchar();
    }
}

int ler_expressao(char expressao[], int tamanho)
{
    int i = 0;

    if(tamanho < 2){
        return 0;
    }

    if(fgets(expressao, tamanho, stdin) == NULL){
        expressao[0] = '\0';
        return 0;
    }

    while(expressao[i] != '\0'){
        if(expressao[i] == '\n'){
            expressao[i] = '\0';
            return 1;
        }

        i++;
    }

    if(feof(stdin)){
        return 1;
    }

    limpa_entrada();
    expressao[0] = '\0';
    return 0;
}

int parenteses_validos(char expressao[])
{
    Tipo_PilhaOperador *topo;

    inicializa_pilha(&topo);

    for(int i = 0; expressao[i] != '\0'; i++){
        if(expressao[i] == '('){
            empilha_operador(&topo, '(');
        }
        else if(expressao[i] == ')'){
            if(pilha_vazia(topo)){
                return 0;
            }

            desempilha_operador(&topo);
        }
    }

    if(!pilha_vazia(topo)){
        libera_pilha(&topo);
        return 0;
    }

    return 1;
}

int caracteres_validos(char expressao[])
{
    char caractere;

    for(int i = 0; expressao[i] != '\0'; i++){
        caractere = expressao[i];

        if(eh_digito(caractere)){
            continue;
        }

        if(eh_operador(caractere)){
            continue;
        }

        if(caractere == '(' || caractere == ')'){
            continue;
        }

        if(caractere == '.'){
            continue;
        }

        if(caractere == ' ' || caractere == '\t' ||
           caractere == '\r'){
            continue;
        }

        return 0;
    }

    return 1;
}

int eh_espaco(char caractere)
{
    if(caractere == ' '){
        return 1;
    }

    if(caractere == '\t'){
        return 1;
    }

    if(caractere == '\r'){
        return 1;
    }

    return 0;
}

int avanca_numero(char expressao[], int *indice)
{
    int i = *indice;
    int pontos = 0;
    int digitos = 0;

    while(eh_digito(expressao[i]) || expressao[i] == '.'){
        if(expressao[i] == '.'){
            pontos++;

            if(pontos > 1){
                return 0;
            }
        }
        else{
            digitos++;
        }

        i++;
    }

    if(digitos == 0){
        return 0;
    }

    *indice = i;
    return 1;
}

int expressao_valida(char expressao[])
{
    int i = 0;
    int esperaNumero = 1;
    char caractere;

    if(!caracteres_validos(expressao)){
        return 0;
    }

    if(!parenteses_validos(expressao)){
        return 0;
    }

    while(expressao[i] != '\0'){
        caractere = expressao[i];

        if(eh_espaco(caractere)){
            i++;
            continue;
        }

        if(esperaNumero == 1){
            if(caractere == '('){
                i++;
                continue;
            }

            if(caractere == '+' || caractere == '-'){
                i++;
                continue;
            }

            if(eh_digito(caractere) || caractere == '.'){
                if(!avanca_numero(expressao, &i)){
                    return 0;
                }

                esperaNumero = 0;
                continue;
            }

            return 0;
        }

        if(eh_operador(caractere)){
            esperaNumero = 1;
            i++;
            continue;
        }

        if(caractere == ')'){
            i++;
            continue;
        }

        return 0;
    }

    if(esperaNumero == 1){
        return 0;
    }

    return 1;
}

int adiciona_token(char saida[], int tamanho, char token[], int quantidade)
{
    int posicao = strlen(saida);

    if(posicao + quantidade + 2 > tamanho){
        return 0;
    }

    for(int i = 0; i < quantidade; i++){
        saida[posicao] = token[i];
        posicao++;
    }

    saida[posicao] = ' ';
    saida[posicao + 1] = '\0';

    return 1;
}

int deve_desempilhar(char operadorPilha, char operadorAtual)
{
    if(operadorPilha == '('){
        return 0;
    }

    if(operadorPilha == '~'){
        if(operadorAtual == '^'){
            return 0;
        }

        return 1;
    }

    if(prioridade(operadorPilha) > prioridade(operadorAtual)){
        return 1;
    }

    if(prioridade(operadorPilha) == prioridade(operadorAtual)){
        if(operadorAtual == '^'){
            return 0;
        }

        return 1;
    }

    return 0;
}

int infixa_para_posfixa(char expressao[], char posfixa[], int tamanho)
{
    Tipo_PilhaOperador *topo;
    int i = 0;
    int inicio;
    int esperaNumero = 1;
    int sucesso = 1;
    char caractere;
    char operador;

    if(tamanho < 1){
        return 0;
    }

    posfixa[0] = '\0';

    if(!expressao_valida(expressao)){
        return 0;
    }

    inicializa_pilha(&topo);

    while(expressao[i] != '\0' && sucesso == 1){
        caractere = expressao[i];

        if(eh_espaco(caractere)){
            i++;
            continue;
        }

        if(eh_digito(caractere) || caractere == '.'){
            inicio = i;
            avanca_numero(expressao, &i);

            sucesso = adiciona_token(posfixa, tamanho,
                                     &expressao[inicio], i - inicio);

            esperaNumero = 0;
            continue;
        }

        if(caractere == '('){
            empilha_operador(&topo, '(');
            esperaNumero = 1;
            i++;
            continue;
        }

        if(caractere == ')'){
            while(!pilha_vazia(topo) &&
                  consulta_topo(topo) != '(' && sucesso == 1){
                operador = desempilha_operador(&topo);
                sucesso = adiciona_token(posfixa, tamanho, &operador, 1);
            }

            if(sucesso == 1){
                desempilha_operador(&topo);
            }

            esperaNumero = 0;
            i++;
            continue;
        }

        if(esperaNumero == 1){
            if(caractere == '-'){
                empilha_operador(&topo, '~');
            }

            i++;
            continue;
        }

        while(!pilha_vazia(topo) && sucesso == 1 &&
              deve_desempilhar(consulta_topo(topo), caractere)){
            operador = desempilha_operador(&topo);
            sucesso = adiciona_token(posfixa, tamanho, &operador, 1);
        }

        if(sucesso == 1){
            empilha_operador(&topo, caractere);
        }

        esperaNumero = 1;
        i++;
    }

    while(!pilha_vazia(topo) && sucesso == 1){
        operador = desempilha_operador(&topo);
        sucesso = adiciona_token(posfixa, tamanho, &operador, 1);
    }

    libera_pilha(&topo);

    if(sucesso == 0){
        posfixa[0] = '\0';
        return 0;
    }

    posfixa[strlen(posfixa) - 1] = '\0';
    return 1;
}

