void libera_pilha_textos(Tipo_PilhaTexto **topo)
{
    Tipo_PilhaTexto *aux;

    while(*topo != NULL){
        aux = *topo;
        *topo = aux->prox;
        free(aux);
    }
}

int combina_prefixa(Tipo_PilhaTexto **topo, char operador)
{
    char primeiro[TAM_CONVERTIDA];
    char segundo[TAM_CONVERTIDA];
    char texto[TAM_CONVERTIDA];
    int tamanho;

    if(operador == '~'){
        if(!desempilha_texto(topo, primeiro)){
            return 0;
        }

        tamanho = snprintf(texto, sizeof(texto), "~ %s", primeiro);
    }
    else{
        if(!eh_operador(operador)){
            return 0;
        }

        if(!desempilha_texto(topo, segundo)){
            return 0;
        }

        if(!desempilha_texto(topo, primeiro)){
            return 0;
        }

        tamanho = snprintf(texto, sizeof(texto), "%c %s %s",
                           operador, primeiro, segundo);
    }

    if(tamanho < 0 || tamanho >= TAM_CONVERTIDA){
        return 0;
    }

    return empilha_texto(topo, texto);
}

int infixa_para_prefixa(char expressao[], char prefixa[], int tamanho)
{
    Tipo_PilhaTexto *topo = NULL;
    char posfixa[TAM_CONVERTIDA];
    char token[TAM_CONVERTIDA];
    int i = 0;
    int inicio;
    int quantidade;
    int sucesso = 1;

    if(tamanho < 1){
        return 0;
    }

    prefixa[0] = '\0';

    if(!infixa_para_posfixa(expressao, posfixa, TAM_CONVERTIDA)){
        return 0;
    }

    while(posfixa[i] != '\0' && sucesso == 1){
        if(eh_espaco(posfixa[i])){
            i++;
            continue;
        }

        inicio = i;

        while(posfixa[i] != '\0' && !eh_espaco(posfixa[i])){
            i++;
        }

        quantidade = i - inicio;
        memcpy(token, &posfixa[inicio], quantidade);
        token[quantidade] = '\0';

        if(eh_digito(token[0]) || token[0] == '.'){
            sucesso = empilha_texto(&topo, token);
        }
        else{
            sucesso = combina_prefixa(&topo, token[0]);
        }
    }

    if(sucesso == 1){
        if(!desempilha_texto(&topo, token)){
            sucesso = 0;
        }
        else if(topo != NULL){
            sucesso = 0;
        }
        else if((int) strlen(token) >= tamanho){
            sucesso = 0;
        }
        else{
            strcpy(prefixa, token);
        }
    }

    libera_pilha_textos(&topo);
    return sucesso;
}

int calcula_expressao(char expressao[], double *resultado)
{
    char posfixa[TAM_CONVERTIDA];

    if(!infixa_para_posfixa(expressao, posfixa, TAM_CONVERTIDA)){
        return 0;
    }

    return calcula_posfixa(posfixa, resultado);
}

int insere_expressao(Tipo_Expressao **inicio, char expressao[],double resultado, int situacao)
{
    Tipo_Expressao *novo;
    Tipo_Expressao *atual;

    if(strlen(expressao) >= TAM_EXPRESSAO){
        return 0;
    }

    novo = malloc(sizeof(Tipo_Expressao));

    if(novo == NULL){
        return 0;
    }

    strcpy(novo->expressao, expressao);
    novo->resultado = resultado;
    novo->situacao = situacao;
    novo->prox = NULL;

    if(*inicio == NULL){
        *inicio = novo;
    }
    else{
        atual = *inicio;

        while(atual->prox != NULL){
            atual = atual->prox;
        }

        atual->prox = novo;
    }

    return 1;
}

void mostra_resultados(Tipo_Expressao *inicio)
{
    Tipo_Expressao *atual = inicio;

    if(inicio == NULL){
        printf("Nenhuma expressao registrda\n");
        return;
    }

    printf("\nResultados das expressoes:\n");

    while(atual != NULL){
        printf("%s = ", atual->expressao);

        if(atual->situacao == 1){
            printf("%.10g\n", atual->resultado);
        }
        else if(atual->situacao == 2){
            printf("Expressao invalida.\n");
        }
        else{
            printf("Erro no calculo.\n");
        }

        atual = atual->prox;
    }
}

void libera_expressoes(Tipo_Expressao **inicio)
{
    Tipo_Expressao *aux;

    while(*inicio != NULL){
        aux = *inicio;
        *inicio = aux->prox;
        free(aux);
    }
}

void processa_expressoes(void)
{
    Tipo_Expressao *inicio = NULL;
    char expressao[TAM_EXPRESSAO];
    double resultado;
    int situacao;

    printf("\nDigite uma expressao por linha. Digite FIM para encerrar.\n");

    for(;;){
        printf("Expressao: ");

        if(!ler_expressao(expressao, TAM_EXPRESSAO)){
            if(feof(stdin) || ferror(stdin)){
                break;
            }

            printf("Nao foi possivel ler a expressao.\n");
            continue;
        }

        if(strcmp(expressao, "FIM") == 0 ||
           strcmp(expressao, "fim") == 0){
            break;
        }

        resultado = 0;

        if(!expressao_valida(expressao)){
            situacao = 2;
        }
        else if(!calcula_expressao(expressao, &resultado)){
            situacao = 3;
        }
        else{
            situacao = 1;
        }

        if(!insere_expressao(&inicio, expressao, resultado, situacao)){
            printf("Problema de alocacao.\n");
            break;
        }
    }

    mostra_resultados(inicio);
    libera_expressoes(&inicio);
}

int main(void)
{
    int opcao;
    int leitura;
    char expressao[TAM_EXPRESSAO];
    char convertida[TAM_CONVERTIDA];

    for(;;)
    {
        printf("\n1. Converter infixa para pos-fixa");
        printf("\n2. Converter infixa para pre-fixa");
        printf("\n3. Verificar se a expressao e valida");
        printf("\n4. Calcular expressoes");
        printf("\n5. sair");
        printf("\nDigite a sua opcao: ");

        leitura = scanf("%d", &opcao);

        if(leitura != 1){
            if(feof(stdin) || ferror(stdin)){
                return 0;
            }

            limpa_entrada();
            printf("\nOpcao invalida.\n");
            continue;
        }

        limpa_entrada();

        if(opcao >= 1 && opcao <= 3){
            printf("\nDigite a expressao: ");

            if(!ler_expressao(expressao, TAM_EXPRESSAO)){
                if(feof(stdin) || ferror(stdin)){
                    return 0;
                }

                printf("Nao foi possivel ler a expressao.\n");
                continue;
            }
        }

        switch(opcao)
        {
            case 1:{
                if(infixa_para_posfixa(expressao, convertida,
                                      TAM_CONVERTIDA)){
                    printf("Posfixa: %s\n", convertida);
                }
                else{
                    printf("Nao foi possivel converter a expressao.\n");
                }
                break;
            }

            case 2:{
                if(infixa_para_prefixa(expressao, convertida,
                                      TAM_CONVERTIDA)){
                    printf("Prefixa: %s\n", convertida);
                }
                else{
                    printf("Nao foi possivel converter a expressao.\n");
                }
                break;
            }

            case 3:{
                if(expressao_valida(expressao)){
                    printf("Expressao valida.\n");
                }
                else{
                    printf("Expressao invalida.\n");
                }
                break;
            }

            case 4:{
                processa_expressoes();
                break;
            }

            case 5:{
                return 0;
            }

            default:
                printf("\nOpcao invalida.\n");
        }
    }
}
