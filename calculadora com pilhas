    }
}

int aplica_operacao(char operador, double primeiro, double segundo, double *resultado)
{
    if(operador == '+'){
        *resultado = primeiro + segundo;
    }
    else if(operador == '-'){
        *resultado = primeiro - segundo;
    }
    else if(operador == '*'){
        *resultado = primeiro * segundo;
    }
    else if(operador == '/'){
        if(segundo == 0){
            return 0;
        }

        *resultado = primeiro / segundo;
    }
    else if(operador == '^'){
        *resultado = pow(primeiro, segundo);
    }
    else{
        return 0;
    }

    if(!isfinite(*resultado)){
        return 0;
    }

    return 1;
}

int calcula_posfixa(char posfixa[], double *resultado)
{
    Tipo_PilhaNumero *topo;
    int i = 0;
    int sucesso = 1;
    char caractere;
    char *fim;
    double valor;
    double primeiro;
    double segundo;

    inicializa_pilha_numeros(&topo);

    while(posfixa[i] != '\0' && sucesso == 1){
        caractere = posfixa[i];

        if(eh_espaco(caractere)){
            i++;
            continue;
        }

        if(eh_digito(caractere) || caractere == '.'){
            valor = strtod(&posfixa[i], &fim);

            if(fim == &posfixa[i] || !isfinite(valor)){
                sucesso = 0;
                break;
            }

            if(*fim != '\0' && !eh_espaco(*fim)){
                sucesso = 0;
                break;
            }

            empilha_numero(&topo, valor);
            i = fim - posfixa;
            continue;
        }

        if(posfixa[i + 1] != '\0' &&
           !eh_espaco(posfixa[i + 1])){
            sucesso = 0;
            break;
        }

        if(caractere == '~'){
            if(!desempilha_numero(&topo, &valor)){
                sucesso = 0;
                break;
            }

            empilha_numero(&topo, -valor);
            i++;
            continue;
        }

        if(eh_operador(caractere)){
            if(!desempilha_numero(&topo, &segundo)){
                sucesso = 0;
                break;
            }

            if(!desempilha_numero(&topo, &primeiro)){
                sucesso = 0;
                break;
            }

            if(!aplica_operacao(caractere, primeiro, segundo, &valor)){
                sucesso = 0;
                break;
            }

            empilha_numero(&topo, valor);
            i++;
            continue;
        }

        sucesso = 0;
    }

    if(sucesso == 1){
        if(!desempilha_numero(&topo, &valor)){
            sucesso = 0;
        }
        else if(!pilha_numeros_vazia(topo)){
            sucesso = 0;
        }
        else{
            *resultado = valor;
        }
    }

    libera_pilha_numeros(&topo);
    return sucesso;
}

