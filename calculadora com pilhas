    }

    novo = malloc(sizeof(Tipo_PilhaTexto));

    if(novo == NULL){
        return 0;
    }

    strcpy(novo->texto, texto);
    novo->prox = *topo;
    *topo = novo;

    return 1;
}

int desempilha_texto(Tipo_PilhaTexto **topo, char texto[])
{
    Tipo_PilhaTexto *aux;

    if(*topo == NULL){
        return 0;
    }

    aux = *topo;
    strcpy(texto, aux->texto);
    *topo = aux->prox;

    free(aux);
    return 1;
